{
    "manifest_version": 3,
    "name": "Defend - Cyberbullying Blocker",
    "version": "1.0.0",
    "description": "Protects you from online harassment by hiding toxic comments on social media.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "offscreen"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
        {
            "resources": ["dist/ort/*", "dist/model/*", "dist/offscreen.html", "dist/offscreen.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*",
        "http://localhost:5000/*"
    ],
    "background": {
        "service_worker": "dist/background.js"
    },
    "action": {
        "default_popup": "dist/src/popup/popup.html",
        "default_title": "Defend"
    },
    "content_scripts": [
        {
            "matches": ["https://*/*", "http://*/*"],
            "js": ["dist/content.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "public/icons/icon16.png",
        "48": "public/icons/icon48.png"
    }
}